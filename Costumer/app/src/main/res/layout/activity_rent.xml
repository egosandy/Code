<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/mapView"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:id="@+id/pickUpContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/space"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TxtAmbil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center"
                android:minWidth="250dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="Set Lokasi"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/pickUpButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/map_me" />
        </LinearLayout>

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="15dp"

            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentEnd="true"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="15dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="80dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/layanan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Layanan"
                    android:textColor="@color/black"
                    android:textSize="20dp" />

                <TextView
                    android:id="@+id/layanandes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Layanan Pengantaran"
                    android:textColor="@color/gray"
                    android:textSize="15dp" />

            </LinearLayout>

        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_10dp"
            android:layout_marginTop="130dp"
            android:layout_marginEnd="@dimen/dimen_10dp"
            android:layout_marginBottom="@dimen/dimen_10dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="@dimen/dimen_5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/dimen_5dp"
                android:paddingBottom="@dimen/dimen_5dp">




                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dimen_5dp">

                    <ImageView
                        android:id="@+id/imgdest"
                        android:layout_width="@dimen/dimen_30dp"
                        android:layout_height="@dimen/dimen_30dp"
                        android:padding="@dimen/dimen_5dp"
                        android:src="@drawable/cap"
                        app:tint="@color/hijau_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginEnd="@dimen/dimen_5dp"
                        android:layout_toRightOf="@id/imgdest"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/NameTujuan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dmsans_bold"
                            android:text="Tujuan"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/pickUpText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dmsans_regular"
                            android:hint="Loading...."
                            android:maxLines="1" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="60dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/button_round_1"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:padding="10dp"
            android:text="Status"
            android:textColor="@color/black"
            android:visibility="gone" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="140dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        tools:ignore="MissingPrefix">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">


            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="232dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="15dp"
                            android:text="Duration"
                            android:textSize="18dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:text="Saldo :"
                            android:textSize="15dp"
                            android:textColor="@color/black" />
                        <TextView
                            android:id="@+id/saldo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            android:singleLine="true"
                            android:text="Rp.50.000 "
                            android:textSize="15dp"
                            android:textColor="@color/black" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/enamjam"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/selector"
                            android:text="1 hour"
                            android:textColor="@color/navy" />

                        <Button
                            android:id="@+id/duabelasjam"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/selector"
                            android:text="2 Hour"
                            android:textColor="@color/navy" />

                        <Button
                            android:id="@+id/satuhari"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/selector"
                            android:text="3 Hour"
                            android:textColor="@color/navy" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:orientation="vertical"
                        android:visibility="visible">




                        <LinearLayout
                            android:id="@+id/llpayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <TextView

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="15dp"
                                android:text="promo code not available!"
                                android:textColor="@color/red"
                                android:textSize="13dp"
                                android:visibility="gone" />

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="@dimen/dimen_10dp"
                                app:cardCornerRadius="5dp"
                                app:cardElevation="@dimen/dimen_5dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="@dimen/dimen_10dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dimen_5dp"
                                        android:orientation="horizontal"
                                        android:visibility="visible">

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:background="@drawable/bg_rectangle_border"
                                            android:orientation="horizontal">

                                            <Button
                                                android:id="@+id/btnpromo"
                                                android:layout_width="23dp"
                                                android:layout_height="23dp"
                                                android:layout_centerInParent="true"
                                                android:layout_gravity="center"
                                                android:background="@drawable/ic_edit"
                                                android:layout_marginEnd="5dp"
                                                android:backgroundTint="@color/colorPrimaryDark"
                                                android:text="Ok"
                                                android:textSize="10dp"
                                                app:tint="@color/white" />


                                            <EditText
                                                android:id="@+id/promocode"
                                                android:layout_width="100dp"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/dmsans_medium"
                                                android:hint="Masukkan Kode"
                                                android:textColorHint="@color/gray"
                                                android:textSize="11dp"
                                                android:background="@null" />                                                    </LinearLayout>

                                        <TextView
                                            android:id="@+id/promonotif"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="15dp"
                                            android:text="promo code not available!"
                                            android:textColor="@color/red"
                                            android:textSize="13dp"
                                            android:visibility="gone" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="right">


                                            <LinearLayout
                                                android:id="@+id/llcheckedwallet"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="@dimen/dimen_5dp"
                                                android:layout_marginEnd="@dimen/dimen_5dp"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal">

                                                <RelativeLayout
                                                    android:layout_width="25dp"
                                                    android:layout_height="25dp">

                                                    <ImageButton
                                                        android:id="@+id/checkedwallet"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:layout_centerInParent="true"
                                                        android:layout_marginStart="5dp"
                                                        android:layout_marginTop="5dp"
                                                        android:layout_marginEnd="5dp"
                                                        android:layout_marginBottom="5dp"
                                                        android:background="@drawable/btn_rect"
                                                        android:backgroundTint="@color/darkgray" />
                                                </RelativeLayout>


                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="10dp"
                                                    android:layout_marginRight="0dp"
                                                    android:orientation="vertical">

                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:orientation="horizontal">

                                                        <TextView
                                                            android:id="@+id/walletpayment"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="20dp"
                                                            android:singleLine="true"
                                                            android:text="Saldo "
                                                            android:textColor="@color/black" />



                                                        <TextView
                                                            android:id="@+id/topUp"
                                                            android:layout_width="0dp"
                                                            android:layout_height="20dp"
                                                            android:layout_weight="1"
                                                            android:gravity="right"
                                                            android:singleLine="true"
                                                            android:text="TopUp"
                                                            android:textColor="@color/colorgradient"
                                                            android:textStyle="bold"
                                                            android:visibility="gone" />

                                                    </LinearLayout>

                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:orientation="horizontal"
                                                        android:visibility="gone">

                                                        <TextView
                                                            android:id="@+id/ketsaldo"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_weight="1"
                                                            android:text="Bayar Dengan Saldo"
                                                            android:textColor="@color/gray"
                                                            android:textSize="14dp" />

                                                    </LinearLayout>
                                                </LinearLayout>

                                            </LinearLayout>

                                            <LinearLayout
                                                android:id="@+id/llcheckedcash"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="@dimen/dimen_5dp"
                                                android:layout_marginEnd="@dimen/dimen_5dp"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:visibility="visible">

                                                <RelativeLayout
                                                    android:layout_width="25dp"
                                                    android:layout_height="25dp">

                                                    <ImageView
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:layout_centerInParent="true"
                                                        android:src="@drawable/button_round_2"
                                                        app:tint="@color/white" />

                                                    <ImageButton
                                                        android:id="@+id/checkedcash"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:layout_centerInParent="true"
                                                        android:layout_marginStart="5dp"
                                                        android:layout_marginTop="5dp"
                                                        android:layout_marginEnd="5dp"
                                                        android:layout_marginBottom="5dp"
                                                        android:background="@drawable/btn_rect"
                                                        android:backgroundTint="@color/darkgray" />
                                                </RelativeLayout>


                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="10dp"
                                                    android:layout_marginRight="15dp"
                                                    android:orientation="vertical">

                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:orientation="horizontal">

                                                        <TextView
                                                            android:id="@+id/cashPayment"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="20dp"
                                                            android:singleLine="true"
                                                            android:text="Tunai"
                                                            android:textColor="@color/black" />

                                                    </LinearLayout>

                                                </LinearLayout>

                                            </LinearLayout>
                                        </LinearLayout>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:paddingStart="@dimen/dimen_5dp"
                                        android:paddingEnd="@dimen/dimen_5dp">

                                        <!--jarak dan estimasi-->

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="left"
                                            android:orientation="vertical"
                                            android:paddingBottom="7dp">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:orientation="horizontal">

                                                <LinearLayout
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:orientation="vertical">

                                                    <TextView
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:fontFamily="@font/dmsans_regular"
                                                        android:text="Jarak"
                                                        android:textColor="@color/black"
                                                        android:textSize="15dp" />
                                                </LinearLayout>

                                                <TextView
                                                    android:id="@+id/distance"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:fontFamily="@font/dmsans_regular"
                                                    android:gravity="right"
                                                    android:padding="8dp"
                                                    android:text="1km"
                                                    android:textColor="@color/default_badge_background_color"
                                                    android:textSize="15dp" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:orientation="horizontal">

                                                <LinearLayout
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:orientation="vertical">

                                                    <TextView
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:fontFamily="@font/dmsans_regular"
                                                        android:text="Estimasi"
                                                        android:textColor="@color/black"
                                                        android:textSize="15dp" />
                                                </LinearLayout>

                                                <TextView
                                                    android:id="@+id/fitur"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:layout_marginStart="10dp"
                                                    android:fontFamily="@font/dmsans_regular"
                                                    android:text="1Min"
                                                    android:textColor="@color/red"
                                                    android:textSize="15dp" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <!--jarak dan estimasi batas bawa-->
                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:orientation="horizontal">


                                                <TextView
                                                    android:id="@+id/cost"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:fontFamily="@font/dmsans_regular"
                                                    android:gravity="right"
                                                    android:padding="8dp"
                                                    android:text="Rp0"
                                                    android:textColor="@color/dark"
                                                    android:textSize="15dp"
                                                    android:visibility="gone" />
                                            </LinearLayout>

                                        </LinearLayout>


                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/dmsans_regular"
                                                    android:text="Diskon"
                                                    android:textColor="@color/black"
                                                    android:textSize="15dp"
                                                    android:visibility="gone" />
                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/numdiskon"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:visibility="gone" />

                                            <TextView
                                                android:id="@+id/diskon"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/dmsans_regular"
                                                android:gravity="right"
                                                android:padding="8dp"
                                                android:text="Rp0"
                                                android:textColor="@color/dark"
                                                android:textSize="15dp"
                                                android:visibility="gone" />
                                        </LinearLayout>


                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="right"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:layout_weight="1"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:fontFamily="@font/dmsans_bold"
                                                    android:text="Total"
                                                    android:textColor="@color/transparent"
                                                    android:textSize="15dp" />
                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/price"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/dmsans_bold"
                                                android:gravity="right"
                                                android:padding="8dp"
                                                android:text="Rp0"
                                                android:textColor="@color/dark"
                                                android:textSize="20dp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@color/white"
                                        android:orientation="horizontal">

                                        <Button
                                            android:id="@+id/order"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentBottom="true"
                                            android:background="@color/colorPrimary"
                                            android:fontFamily="@font/dmsans_bold"
                                            android:text="Pesan Sekarang"
                                            android:textColor="@color/black" />

                                        <Button
                                            android:id="@+id/quickorders"
                                            android:layout_width="wrap_content"
                                            android:layout_height="40dp"
                                            android:layout_marginStart="5dp"
                                            android:layout_marginTop="15dp"
                                            android:layout_marginEnd="@dimen/dimen_15dp"
                                            android:layout_marginBottom="@dimen/dimen_15dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/button_round_1"
                                            android:enabled="false"
                                            android:text="Pilih Driver"
                                            android:textAllCaps="false"
                                            android:textColor="@color/white"
                                            android:textSize="18sp"
                                            android:visibility="gone" />

                                        <Button
                                            android:id="@+id/whatsapp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="40dp"
                                            android:layout_margin="15dp"
                                            android:layout_marginTop="15dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/button_round_1"
                                            android:enabled="true"
                                            android:text="Whatsapp Order"
                                            android:textAllCaps="false"
                                            android:textColor="@color/white"
                                            android:textSize="15sp"
                                            android:visibility="gone" />
                                    </LinearLayout>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>




                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <!-- batas-->

            <!--batas-->
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rlprogress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparentblack"
        android:clickable="true"
        android:visibility="gone">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profileimage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            android:src="@color/white" />

        <TextView
            android:id="@+id/textprogress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profileimage"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="@string/waiting_desc"
            android:textColor="@color/white" />


        <ProgressBar
            android:id="@+id/bar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:elevation="10dp"
                android:src="@drawable/logo" />
        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rlnotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar"
        android:background="@color/red"
        android:visibility="gone">

        <TextView
            android:id="@+id/textnotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="10dp"
            android:textColor="@color/white" />

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>