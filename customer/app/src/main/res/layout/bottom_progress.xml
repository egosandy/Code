<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/bottom_sheet"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="false"
    android:animateLayoutChanges="true"
    app:behavior_peekHeight="310dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <androidx.core.widget.NestedScrollView
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ldriver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorIcons"
                    android:layout_marginTop="-8dp"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentEnd="true"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        android:layout_margin="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:backgroundTint="@color/bgtema">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:background="@color/bgtema"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/StatusDriver"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/dmsans_medium"
                                        android:padding="@dimen/dimen_10dp"
                                        android:text="Pesanan Kamu Sedang Diproses."
                                        android:textColor="@color/black" />

                                    <TextView
                                        android:id="@+id/Waktu"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:fontFamily="@font/dmsans_medium"
                                        android:gravity="left"
                                        android:padding="@dimen/dimen_10dp"
                                        android:text="0Menit"
                                        android:textColor="@color/black" />
                                </LinearLayout>
                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/fotodriver"
                                            android:layout_width="50dp"
                                            android:layout_height="50dp"
                                            android:src="@drawable/brochure" />

                                        <TextView
                                            android:id="@+id/namadriver"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:layout_marginBottom="@dimen/dimen_5dp"
                                            android:fontFamily="@font/dmsans_bold"
                                            android:text="Nama Driver"
                                            android:textColor="@color/black"
                                            android:textSize="18dp" />

                                        <RatingBar
                                            android:layout_marginTop="@dimen/dimen_5dp"
                                            android:id="@+id/RateBar"
                                            android:layout_height="wrap_content"
                                            android:layout_width="wrap_content"
                                            android:numStars="5"
                                            android:rating="1"
                                            android:scaleX="0.8"
                                            android:scaleY="0.8"
                                            android:transformPivotX="0dp"
                                            android:transformPivotY="0dp"
                                            android:isIndicator="true"
                                            style="@style/foodRatingBar"/>

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">

                                    <TextView
                                        android:id="@+id/platnomor"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="@dimen/dimen_5dp"
                                        android:fontFamily="@font/dmsans_bold"
                                        android:text="E1234B"
                                        android:textColor="@color/dark"
                                        android:textSize="12dp" />
                                    <TextView
                                        android:id="@+id/merk"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="@dimen/dimen_5dp"
                                        android:fontFamily="@font/dmsans_bold"
                                        android:text="Honda"
                                        android:textColor="@color/dark"
                                        android:textSize="12dp" />
                                    <TextView
                                        android:id="@+id/tip"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/dmsans_bold"
                                        android:text="Metik"
                                        android:textColor="@color/dark"
                                        android:textSize="12dp" />

                                    </LinearLayout>


                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dimen_10dp">

                                    <ImageView
                                        android:id="@+id/Telepon"
                                        android:layout_width="@dimen/dimen_40dp"
                                        android:layout_height="@dimen/dimen_40dp"
                                        android:layout_marginEnd="@dimen/dimen_10dp"
                                        android:background="@drawable/card_view_border"
                                        android:padding="@dimen/dimen_10dp"
                                        android:src="@drawable/ic_phone"
                                        app:tint="@color/dark_gray" />

                                    <ImageView
                                        android:id="@+id/Chat"
                                        android:layout_width="@dimen/dimen_40dp"
                                        android:layout_height="@dimen/dimen_40dp"
                                        android:background="@drawable/card_view_border"
                                        android:padding="@dimen/dimen_10dp"
                                        android:src="@drawable/ic_chat"
                                        app:tint="@color/dark_gray"/>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
                <!-- Informasi Pengiriman -->


                <!-- Layout Metode Pembayaran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_view_border"
                    android:layout_margin="@dimen/dimen_10dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_margin="@dimen/dimen_10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:padding="8dp"
                            android:background="@drawable/circle_shape"
                            android:backgroundTint="@color/colorIcons"
                            android:layout_width="@dimen/dimen_30dp"
                            android:layout_height="@dimen/dimen_30dp"
                            android:src="@drawable/icon_topup"
                            app:tint="@color/black" />
                        <TextView
                            android:id="@+id/metode"
                            android:layout_marginStart="@dimen/dimen_10dp"
                            android:layout_marginEnd="@dimen/dimen_10dp"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:fontFamily="@font/dmsans_bold"
                            android:text="Tunai"/>

                        <TextView
                            android:id="@+id/totalbayar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/dimen_10dp"
                            android:layout_marginEnd="@dimen/dimen_10dp"
                            android:fontFamily="@font/dmsans_bold"
                            android:gravity="right"
                            android:text="Rp0"
                            android:textColor="@color/black" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detail Pesanan -->

                <!-- Detail Pembayaran -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="3dp"
                    app:contentPaddingBottom="10dp">

                    <LinearLayout
                        android:id="@+id/detailorder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dimen_10dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dimen_10dp"
                            android:orientation="vertical">

                            <!-- Detail Kurir Order -->
                            <LinearLayout
                                android:id="@+id/LayoutKurir"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/dmsans_bold"
                                        android:gravity="left"
                                        android:text="Jenis Pengiriman"
                                        android:textSize="15dp" />

                                    <TextView
                                        android:id="@+id/produk"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="right"
                                        android:text="Paket"
                                        android:textSize="15dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/bg_editext"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="10dp">

                                    <TextView
                                        android:id="@+id/namapengirim"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="left"
                                        android:text="Nama Pengirim"
                                        android:textSize="15dp" />

                                    <Button
                                        android:id="@+id/kontakpengirim"
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:background="@drawable/edittextbg"
                                        android:backgroundTint="@color/white"
                                        android:text="Hubungi"
                                        android:textColor="@color/black"
                                        app:tint="@color/black" />

                                    <ImageView
                                        android:layout_width="@dimen/dimen_20dp"
                                        android:layout_height="@dimen/dimen_20dp"
                                        android:src="@drawable/ic_phone"
                                        app:tint="@color/black"></ImageView>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:background="@drawable/bg_editext"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="10dp">

                                    <TextView
                                        android:id="@+id/namapenerima"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="left"
                                        android:text="Nama Penerima"
                                        android:textSize="15dp" />

                                    <Button
                                        android:id="@+id/kontakpenerima"
                                        android:layout_width="wrap_content"
                                        android:layout_height="20dp"
                                        android:background="@drawable/edittextbg"
                                        android:backgroundTint="@color/white"
                                        android:text="Hubungi"
                                        android:textColor="@color/black"
                                        app:tint="@color/black" />

                                    <ImageView
                                        android:layout_width="@dimen/dimen_20dp"
                                        android:layout_height="@dimen/dimen_20dp"
                                        android:src="@drawable/ic_phone"
                                        app:tint="@color/black"></ImageView>

                                </LinearLayout>
                            </LinearLayout>
                            <!-- Detail Merchant Order -->
                            <LinearLayout
                                android:id="@+id/LayoutMerchant"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="25dp"
                                        android:layout_height="25dp"
                                        android:layout_marginEnd="10dp"
                                        android:src="@drawable/shopping">

                                    </ImageView>

                                    <TextView
                                        android:id="@+id/titlePickup"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/dmsans_bold"
                                        android:text="Nama Toko"
                                        android:textColor="@color/black"
                                        android:textSize="16dp" />
                                </LinearLayout>

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/daftaritem"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="3dp"
                    android:layout_margin="10dp"
                    app:contentPaddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dimen_10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dmsans_bold"
                            android:textSize="16dp"
                            android:text="Detail Pembayaran"
                            android:textColor="@color/black" />
                        <LinearLayout
                            android:layout_margin="@dimen/dimen_10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <LinearLayout
                                android:id="@+id/layoutharga"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_marginEnd="@dimen/dimen_10dp"
                                    android:layout_gravity="center"
                                    android:gravity="left"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Harga"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                                <TextView
                                    android:id="@+id/harga"
                                    android:layout_gravity="center"
                                    android:gravity="right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp0"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                            </LinearLayout>
                            <ImageView
                                android:layout_gravity="center"
                                android:background="@color/backgroundgray"
                                android:layout_marginTop="@dimen/dimen_15dp"
                                android:layout_marginBottom="@dimen/dimen_5dp"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_marginEnd="@dimen/dimen_10dp"
                                    android:layout_gravity="center"
                                    android:gravity="left"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ongkir"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                                <TextView
                                    android:id="@+id/ongkir"
                                    android:layout_gravity="center"
                                    android:gravity="right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp0"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutdiskon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_marginEnd="@dimen/dimen_10dp"
                                    android:layout_gravity="center"
                                    android:gravity="left"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Diskon"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                                <TextView
                                    android:id="@+id/diskon"
                                    android:layout_gravity="center"
                                    android:gravity="right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp0"
                                    android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />
                            </LinearLayout>

                            <ImageView
                                android:layout_gravity="center"
                                android:background="@color/backgroundgray"
                                android:layout_marginTop="@dimen/dimen_15dp"
                                android:layout_marginBottom="@dimen/dimen_5dp"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_marginEnd="@dimen/dimen_10dp"
                                    android:layout_gravity="center"
                                    android:gravity="left"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Pembayaran"
                                android:fontFamily="@font/dmsans_regular"
                                    android:textColor="@color/black" />

                                <TextView
                                    android:id="@+id/txttotal"
                                    android:layout_gravity="center"
                                    android:gravity="right"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/dmsans_bold"
                                    android:text="Rp0"
                                    android:textColor="@color/black" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="5dp"
                    android:layout_margin="10dp"
                    app:contentPaddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dimen_5dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_margin="@dimen/dimen_10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/dimen_10dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/dmsans_bold"
                                    android:textSize="@dimen/dimen_18dp"
                                    android:textColor="@color/black"
                                    android:text="Detail Pengiriman"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_margin="@dimen/dimen_10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                        <ImageView
                                            android:id="@+id/ImgPickup"
                                            android:layout_gravity="center"
                                            android:background="@drawable/pickup"
                                            android:layout_width="15dp"
                                            android:layout_height="20dp"
                                            android:layout_marginStart="@dimen/dimen_10dp"
                                            app:tint="@color/white" />
                                        <LinearLayout
                                            android:layout_marginStart="@dimen/dimen_10dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_gravity="center"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/dmsans_medium"
                                                android:textColor="@color/steptitle"
                                                android:text="Alamat Jemput"/>
                                            <TextView
                                                android:id="@+id/alamatPickup"
                                                android:layout_gravity="center"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/dmsans_bold"
                                                android:textColor="@color/black"
                                                android:maxLines="1"
                                                android:text="Alamat Lengkap Penjemputan"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                    <View
                                        android:layout_marginStart="@dimen/dimen_15dp"
                                        android:layout_width="1dp"
                                        android:layout_height="20dp"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:background="@drawable/vertical_dotted" />
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:layout_gravity="center"
                                            android:padding="@dimen/dimen_10dp"
                                            android:layout_marginStart="@dimen/dimen_10dp"
                                            android:background="@drawable/map_tujuan"
                                            android:layout_width="15dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/circle_shape"
                                            app:tint="@color/white" />
                                        <LinearLayout
                                            android:layout_marginStart="@dimen/dimen_10dp"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_gravity="center"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/dmsans_medium"
                                                android:textColor="@color/steptitle"
                                                android:text="Alamat Pengantaran"/>
                                            <TextView
                                                android:id="@+id/alamatAntar"
                                                android:layout_gravity="center"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/dmsans_bold"
                                                android:textColor="@color/black"
                                                android:maxLines="1"
                                                android:text="Alamat Lengkap Pengantaran"/>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@color/backgroundgray"
                            android:layout_marginTop="@dimen/dimen_15dp"
                            android:layout_marginBottom="@dimen/dimen_15dp"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"/>
                        <Button
                            android:id="@+id/cancelorder"
                            android:layout_margin="@dimen/dimen_10dp"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dmsans_bold"
                            android:textColor="@color/red"
                            android:text="Batalkan Pesanan"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dimen_10dp"
                    android:orientation="vertical">

                    <TextView
