<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <fragment
            android:id="@+id/locationPicker_maps"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Space
            android:id="@+id/locationPicker_space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerInParent="true" />
        <LinearLayout
            android:backgroundTint="@color/white"
            android:background="@drawable/round_edittext_background"
            android:layout_margin="@dimen/dimen_5dp"
            android:padding="@dimen/dimen_10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dimen_20dp"
                android:layout_height="@dimen/dimen_20dp"
                android:src="@drawable/map_tujuan"/>
            <TextView
                android:id="@+id/Alamat"
                android:layout_marginEnd="@dimen/dimen_5dp"
                android:layout_marginStart="@dimen/dimen_10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:fontFamily="@font/dmsans_medium"
                android:maxLines="2"
                android:hint="Alamat Tujuan"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/locationPicker_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/locationPicker_space"
            android:layout_centerHorizontal="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TxtAmbil"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/circle_border"
                android:fontFamily="@font/dmsans_bold"
                android:gravity="center"
                android:minWidth="250dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="Klik"
                android:textColor="@android:color/black"
                android:textSize="13dp" />

            <ImageView
                android:id="@+id/pickUpButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/linemap"
                app:tint="@color/colorPrimary" />
        </LinearLayout>
        <TextView
            android:id="@+id/locationPicker_currentAddress"
            android:layout_width="@dimen/dimen_0dp"
            android:layout_height="@dimen/dimen_0dp"/>

    </RelativeLayout>

</LinearLayout>