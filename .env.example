# Database (SQLite default — ganti ke postgresql:// untuk produksi)
DATABASE_URL="file:./dev.db"

# Rahasia untuk JWT session admin (WAJIB diganti di produksi!)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-aman"

# Kredensial admin awal (dibuat saat seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Salt tambahan untuk hashing fingerprint perangkat
DEVICE_SALT="ganti-dengan-salt-acak"

# Base URL aplikasi (untuk generate link share)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
